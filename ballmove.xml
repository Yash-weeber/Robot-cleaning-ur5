                  <geom mesh="wrist3" material="linkgray" class="visual"/>
                  <site name="ee_site" pos="0 0.08 0" size="0.01" rgba="1 0 0 1"/>

                  <!-- Mop tool attachment -->
                  <body name="mop_mount" pos="0 0.08 0" quat="1 0 0 1">
                    <body name="mop_tool" pos="0 -0.6 0">
